{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/scan.ts": {
      "maxDuration": 60
    },
    "api/state.ts": {
      "maxDuration": 30
    },
    "api/agent.ts": {
      "maxDuration": 60
    },
    "api/daily.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/agent",
      "schedule": "23 4 * * *"
    },
    {
      "path": "/api/agent?profile=15m",
      "schedule": "47 6 * * *"
    },
    {
      "path": "/api/daily?job=morning",
      "schedule": "11 3 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=0",
      "schedule": "37 0 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=2",
      "schedule": "37 2 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=4",
      "schedule": "41 4 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=6",
      "schedule": "37 6 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=8",
      "schedule": "37 8 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=10",
      "schedule": "37 10 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=12",
      "schedule": "37 12 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=14",
      "schedule": "37 14 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=16",
      "schedule": "37 16 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=18",
      "schedule": "37 18 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=20",
      "schedule": "37 20 * * *"
    },
    {
      "path": "/api/daily?job=watch&h=22",
      "schedule": "37 22 * * *"
    },
    {
      "path": "/api/daily?job=invent",
      "schedule": "23 1 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=1",
      "schedule": "53 1 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=3",
      "schedule": "53 3 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=5",
      "schedule": "53 5 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=7",
      "schedule": "53 7 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=9",
      "schedule": "53 9 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=11",
      "schedule": "53 11 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=13",
      "schedule": "53 13 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=15",
      "schedule": "53 15 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=17",
      "schedule": "53 17 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=19",
      "schedule": "53 19 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=21",
      "schedule": "53 21 * * *"
    },
    {
      "path": "/api/daily?job=replay&h=23",
      "schedule": "53 23 * * *"
    }
  ]
}
