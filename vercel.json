{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/scan.ts": {
      "maxDuration": 60
    },
    "api/state.ts": {
      "maxDuration": 30
    },
    "api/agent.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/agent",
      "schedule": "23 4 * * *"
    },
    {
      "path": "/api/agent?profile=15m",
      "schedule": "47 6 * * *"
    }
  ]
}
